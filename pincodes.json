    <script type="text/rocketlazyloadscript">
    document.addEventListener("DOMContentLoaded", function () {
        //const blueFavicon = 'https://nimbuspost.com/wp-content/uploads/blue.png';   
        //const whiteFavicon = 'https://nimbuspost.com/wp-content/uploads/white.png'; 
	  const blueFavicon = 'https://nimbuspost.com/wp-content/uploads/2026/04/dark-mode-logo.svg';   // Light mode
        const whiteFavicon = 'https://nimbuspost.com/wp-content/uploads/2026/04/light-mode-logo.svg'; // Dark mode



        function updateFavicon() {
            const isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
		// console.log(window.matchMedia("(prefers-color-scheme: dark)").matches);
            const faviconURL = isDark ? whiteFavicon : blueFavicon;

            // Remove old favicon(s)
            document.querySelectorAll('link[rel="icon"], link[rel="shortcut icon"]').forEach(el => el.remove());

            // Add new favicon
            const link = document.createElement('link');
            link.rel = 'icon';
            link.type = 'image/png';
            link.href = faviconURL;
            document.head.appendChild(link);
        }

        updateFavicon();

        // Update on theme change
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", updateFavicon);
    });
