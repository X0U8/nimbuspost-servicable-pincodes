<script>
    // Function to open tracking link
    function trackFunction() {
      const trackingId = document.getElementById("trakings").value.trim();
      if (trackingId === "") {
        alert("Please enter a tracking ID.");
        return;
      }

      const action = "https://ship.nimbuspost.com/shipping/tracking/" + trackingId;
      window.open(action, '_blank'); // open in new tab
    }

    // Attach click event to button with class 'track-btn'
    document.addEventListener("DOMContentLoaded", function () {
      const button = document.querySelector(".track-btn");
      if (button) {
        button.addEventListener("click", trackFunction);
      }
    });
  </script>



