<script type="text/rocketlazyloadscript">
document.addEventListener("DOMContentLoaded", () => {
  // Sab elements jinke andar auto rotate tab chahiye
  const tabSections = document.querySelectorAll('.auto-tab-rotate');

  tabSections.forEach(section => {
    const tabs = Array.from(section.querySelectorAll('.bdt-tabs-item a.bdt-tabs-item-title'));

    if (tabs.length === 0) return;

    let currentIndex = 0;

    function activateTabByIndex(idx) {
      if (!tabs[idx]) return;
      tabs[idx].click(); // trigger BDThemes' native tab switching
    }

    // Start rotation
    activateTabByIndex(currentIndex);

    setInterval(() => {
      currentIndex = (currentIndex + 1) % tabs.length;
      activateTabByIndex(currentIndex);
    }, 5000);
  });
});
</script>

