<script type="text/rocketlazyloadscript" class="outside-jquery" data-rocket-src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script type="text/rocketlazyloadscript">
	jQuery(document).ready(function ($) {
		 setTimeout(function () {
			const queryString = window.location.search.substring(1);  
			if (!queryString) return;

			$('a[href*="nimbuspost"]').each(function () {
				let href = $(this).attr('href');

				if (href.indexOf(queryString) !== -1) return;

				href += (href.indexOf('?') !== -1 ? '&' : '?') + queryString;
				$(this).attr('href', href);
			});
			const params = new URLSearchParams(window.location.search);
    			if (!params.has('s')) return; 
    			const searchQuery = 's=' + encodeURIComponent(params.get('s'));
			$('a.nimbus-page-link').each(function () {
        			let href = $(this).attr('href');
        			if (!href) return;
			        if (href.indexOf(searchQuery) !== -1) return;        
				        href += (href.indexOf('?') !== -1 ? '&' : '?') + searchQuery;
        				$(this).attr('href', href);
    			});

    		    	$('a').not('a.nimbus-page-link').each(function () {
        			let href = $(this).attr('href');
        			if (!href) return;
        			href = href.replace(/([?&])s=[^&]*/g, '').replace(/[?&]$/, '');
        			$(this).attr('href', href);
    			});

		}, 1000);
	});
	

