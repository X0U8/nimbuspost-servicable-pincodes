function openSocialPopup(url) {
    const width = 600;
    const height = 500;
    const left = (screen.width - width) / 2;
    const top = (screen.height - height) / 2;

    window.open(url, 'ShareWindow', `width=${width},height=${height},top=${top},left=${left}`);
    return false;
}


