<script>
function openSocialPopup(url) {
    const width = 600;
    const height = 500;
    const left = (screen.width - width) / 2;
    const top = (screen.height - height) / 2;

    window.open(url, 'ShareWindow', `width=${width},height=${height},top=${top},left=${left}`);
    return false;
}


</script>




<script>
(function() {
  // Only remove if hash === '#'
  function cleanHash() {
    if (location.hash === '#') {
      history.replaceState(null, '', location.pathname + location.search);
    }
  }

  // Prevent default for all <a href="#">
  function preventHrefHashLinks() {
    document.querySelectorAll('a[href="#"]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
      });
      el.setAttribute('href', 'javascript:void(0)'); // Optionally change href
    });
  }

  // Run on load
  document.addEventListener('DOMContentLoaded', function () {
    cleanHash();
    preventHrefHashLinks();
  });

  // Run when hash changes
  window.addEventListener('hashchange', cleanHash);

  // Re-check every 300ms (some scripts add # again later)
  setInterval(cleanHash, 300);
})();
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const sections = document.querySelectorAll(".scroll-section");
  const stickyImg = document.getElementById("sticky-img");

  function updateImage() {
    sections.forEach((sec) => {
      const rect = sec.getBoundingClientRect();
      // Check if section is in middle of viewport
      if (rect.top < window.innerHeight / 2 && rect.bottom > window.innerHeight / 2) {
        const newImage = sec.getAttribute("data-image");
        if (newImage && stickyImg.src !== newImage) {
          stickyImg.style.opacity = 0;
          setTimeout(() => {
            stickyImg.src = newImage;
            stickyImg.style.opacity = 1;
          }, 200);
        }
      }
    });
  }

  window.addEventListener("scroll", updateImage);
  updateImage(); // run once on load
});

</script>


<script>

document.addEventListener("keydown", function(e) {
  var slider = document.querySelector(".swiper");
  if (!slider || !slider.swiper) return;

  if (e.key === "ArrowRight") {
    slider.swiper.slideNext();
  } else if (e.key === "ArrowLeft") {
    slider.swiper.slidePrev();
  }
});


</script>


